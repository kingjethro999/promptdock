rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // PromptDock writes this mirror from its server Admin SDK. Deny direct
    // browser writes so app sessions and Firebase identities stay unified.
    match /users/{userId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
