{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "promptdock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "APP_URL=http://localhost:3111",
        "npx",
        "next",
        "dev",
        "-p",
