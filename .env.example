# Copy to .env and fill in one or more providers to enable AI suggestions.
APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_MODEL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_TIMEOUT_MS=45000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_PROVIDER_ORDER=apmix,groq,gemini
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_FALLBACKS=2

# Vercel server-side only: use Render Postgres's External Connection Pool URL.
# DATABASE_URL=postgresql://user:password@host:6432/promptdock?sslmode=require

# Optional local PostgreSQL sync (start database/compose.yaml first).
# PGHOST=127.0.0.1
# PGPORT=5434
# PGDATABASE=promptdock
# PGUSER=promptdock
# PGPASSWORD=use-the-password-from-database-env
