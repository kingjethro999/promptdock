# Copy to .env and fill in one or more providers to enable AI suggestions.
APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_MODEL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

AI_PROVIDER_ORDER=apmix,groq,gemini
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_FALLBACKS=2
