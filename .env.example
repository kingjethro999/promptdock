# Copy to .env and fill in one or more providers to enable AI suggestions.
APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_MODEL=claude-sonnet-4-6-free
APMIX_VISION_MODEL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_TIMEOUT_MS=45000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=

# Optional system-wide custom endpoints. Personal keys saved in Settings win.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
ANTHROPIC_VISION_MODEL=

AI_PROVIDER_ORDER=apmix,groq,gemini,openai,anthropic
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_FALLBACKS=2

# Server-side only: use Render Postgres's External URL.
# DATABASE_URL=postgresql://user:password@host:5432/promptdock?sslmode=verify-full

# Account verification and password reset emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=king18jsquare@gmail.com
# Set to your final public site URL after deployment (e.g. https://promptdock.vercel.app).
APP_URL=

# 64 hex characters (32 random bytes). Use the same value on every deployment.
BYOK_ENCRYPTION_KEY=
# Firebase web configuration (safe to expose to the browser; protected by Auth/rules)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin credentials (server only; never use NEXT_PUBLIC_ for these)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
