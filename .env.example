# PromptDock environment template
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env, .env.local, production secrets, or Firebase service-account keys.

# -----------------------------------------------------------------------------
# AI providers
# -----------------------------------------------------------------------------
APMIX_API_KEY=
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_MODEL=claude-sonnet-4-6-free
APMIX_VISION_MODEL=

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
TRANSCRIPTION_TIMEOUT_MS=45000

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=

# Optional system-wide custom endpoints. Personal keys saved in Settings win.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_VISION_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=
ANTHROPIC_VISION_MODEL=

# Provider order is used for fallback selection.
AI_PROVIDER_ORDER=apmix,groq,gemini,openai,anthropic
AI_REQUEST_TIMEOUT_MS=12000
AI_MAX_FALLBACKS=2

# -----------------------------------------------------------------------------
# Optional research and observability services
# -----------------------------------------------------------------------------
# Get a Firecrawl key at https://www.firecrawl.dev/app
FIRECRAWL_API_KEY=
# Get a Jina AI key at https://jina.ai/
JINA_API_KEY=

ENABLE_LANGFUSE_TRACING=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASEURL=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Use your deployment provider's connection string.
DATABASE_URL=
PSQL_COMMAND=
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Email, application URL, and encryption
# -----------------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_EMAIL=
# Set this to the public site URL after deployment.
APP_URL=
# 64 hex characters (32 random bytes). Use the same value on every deployment.
BYOK_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Firebase Web SDK (safe to expose to the browser)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (server-only; never use NEXT_PUBLIC_ for these)
# Obtain these from Firebase Project settings -> Service accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
