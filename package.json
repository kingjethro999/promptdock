{
  "name": "promptdock",
  "version": "0.1.4",
  "private": true,
  "description": "An idea-to-prompt workspace with voice input and optional PostgreSQL sync",
  "scripts": {
    "start": "npm run build:frontend && node src/server.js",
    "start:api": "node src/server.js",
    "build:frontend": "node scripts/build-frontend.js",
    "test": "node --test",
    "version:bump": "node scripts/bump-version.js",
    "setup:hooks": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0"
  }
}
