{
  "name": "promptdock",
  "version": "0.4.7",
  "private": true,
  "description": "An idea-to-prompt workspace with voice input and optional PostgreSQL sync",
  "license": "MIT",
  "scripts": {
    "start": "npm run build:frontend && node src/server.js",
    "start:api": "node src/server.js",
    "build:frontend": "node scripts/build-frontend.js",
    "test": "node --test",
    "version:bump": "node scripts/bump-version.js",
    "setup:hooks": "git config core.hooksPath .githooks",
    "headers:sync": "node scripts/sync-vercel-headers.js",
    "headers:check": "node scripts/sync-vercel-headers.js --check",
    "lint": "eslint src api scripts test eslint.config.cjs"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "jsdom": "^30.1.1"
  }
}
